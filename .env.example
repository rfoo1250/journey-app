# Copy to .env and adjust. .env is git-ignored; never commit real keys.

# Self-hosted Valhalla (SETUP.md §7). Use LAN IP or cloudflared URL for phones.
VALHALLA_BASE_URL=http://localhost:8002

# MapLibre style URL (SETUP.md §8). OpenFreeMap needs no key.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
